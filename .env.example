# ==============================================================================
# Small Shop Assistant — Environment Configuration Template
# ==============================================================================

# Unique identifier for the kirana shop / retail business
SHOP_ID="SHOP-001"

# Numeric Telegram ID of the registered shop owner (authentication gate)
# Messages from any other Telegram user will be immediately rejected with 403 Unauthorized
OWNER_TELEGRAM_ID="7973198714"

# Google Sheets Spreadsheet ID / Name containing the 'EventJournal' tab
GOOGLE_SHEETS_JOURNAL_ID="Small_Shop_Assistant_Journal"

# Telegram Bot Token obtained from @BotFather (for n8n Telegram API Credential)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# (Optional) Timezone configuration
GENERIC_TIMEZONE="Asia/Kolkata"

# (Optional) Enterprise PostgreSQL / Supabase Configuration
# Required only if using the ACID-compliant SQL procedure in 'enterprise-postgres/'
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="small_shop_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password"
