              "id": "v1",
              "name": "errors",
              "type": "array",
              "value": "={{ (() => { const j = $json; const e = []; const need = { SALE: ['amount'], CREDIT_SALE: ['customer_name','amount'], REPAYMENT: ['customer_name','amount'], STOCK_IN: ['product_name','quantity','unit'], STOCK_OUT: ['product_name','quantity','unit'], ACCEPTED_ORDER: ['customer_name','product_name','quantity','unit'] }; const allowed = ['event_type','customer_name','customer_id','product_name','product_id','amount','quantity','unit','currency','shop_id','source_update_id','source_message_id','chat_id','sender_id','source_text']; Object.keys(j).forEach(k => { if (!allowed.includes(k)) e.push('Unknown field: ' + k); }); if (!j.shop_id) e.push('Missing required field: shop_id'); const req = need[j.event_type]; if (!req) { e.push('Unsupported event_type: ' + j.event_type); return e; } req.forEach(f => { const v = f === 'customer_name' ? (j.customer_name || j.customer_id) : f === 'product_name' ? (j.product_name || j.product_id) : j[f]; if (v === null || v === undefined || v === '') e.push('Missing required field: ' + f); }); ['amount','quantity'].forEach(f => { const v = j[f]; if (v !== null && v !== undefined && v !== '') { if (typeof v !== 'number' || !isFinite(v)) e.push(f + ' must be a number'); else if (v <= 0) e.push(f + ' must be positive'); } }); if (j.unit && !['kg','g','litre','ml','packet','piece','dozen'].includes(j.unit)) e.push('Invalid unit: ' + j.unit); if (j.currency && j.currency !== 'INR') e.push('Currency must be INR'); return e; })() }}"
