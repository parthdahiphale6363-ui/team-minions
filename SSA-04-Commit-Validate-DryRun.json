            {
              "id": "val0",
              "name": "verdict",
              "type": "object",
              "value": "={{ (() => { const rows = $('Lookup Proposal by Token').all().map(i => i.json).filter(r => r.event_id); const led = $('Lookup Ledger State').all().map(i => i.json).filter(r => r.journal_id); const who = $('Check Command and Owner').first().json; if (rows.length === 0) return { ok: false, reasons: ['TOKEN_NOT_FOUND_OR_ALREADY_USED'] }; if (rows.length > 1) return { ok: false, reasons: ['DUPLICATE_TOKEN_HASH'] }; const r = rows[0]; const reasons = []; if (r.status !== 'APPROVAL_ISSUED') reasons.push('NOT_APPROVABLE:' + r.status); if ($now.toMillis() > r.expires_epoch) reasons.push('EXPIRED'); if (String(r.sender_id) !== String(who.sender_id)) reasons.push('SENDER_MISMATCH'); if (led.length !== 1) reasons.push('LEDGER_STATE_UNAVAILABLE'); else if (led[0].revision !== r.ledger_revision || led[0].journal_id !== r.journal_id || led[0].shop_id !== r.shop_id) reasons.push('STALE_LEDGER_REVISION'); if ($json.binding_hash_check !== r.binding_hash) reasons.push('BINDING_MISMATCH'); return { ok: reasons.length === 0, reasons: reasons, event_id: r.event_id }; })() }}"
            }
          ]
        },
        "options": {}
