              "type": "string",
              "value": "={{ (() => { const r = $input.all().map(i => i.json).filter(x => x.event_id)[0]; const ok = r && r.status === $('Validate Invalidation').first().json.verdict.new_status && !r.token_hash; const verb = $('Check Cancel or Edit Command').first().json.verb; return ok ? (verb === 'EDIT' ? 'Approval invalidated; the proposal is superseded. Re-preparing an edited proposal is not built yet, so send the corrected command again. Nothing was committed.' : 'Proposal cancelled and its approval token invalidated. Nothing was committed.') : 'Invalidation could not be confirmed on re-read. Treat the token as possibly still active until it expires. Nothing was committed.'; })() }}"
