              "id": "che0",
              "name": "cmd",
              "type": "object",
              "value": "={{ (() => { const t = String($json.text ?? ''); const m = /^(CANCEL|EDIT) ([0-9a-f]{16})( .+)?$/.exec(t); const verb = m ? m[1] : ''; const fmt = !!m && (verb === 'EDIT' ? !!m[3] : !m[3]); const owner = String($json.sender_id ?? '') === '7973198714'; return { format_ok: fmt, owner_ok: owner, verb: verb, token: fmt ? m[2] : '', edit_text: fmt && verb === 'EDIT' ? m[3].trim() : '', reasons: [owner ? '' : 'NOT_OWNER', fmt ? '' : 'BAD_COMMAND_FORMAT'].filter(x => x) }; })() }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
