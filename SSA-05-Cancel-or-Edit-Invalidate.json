              "name": "verdict",
              "type": "object",
              "value": "={{ (() => { const rows = $('Lookup Proposal by Token').all().map(i => i.json).filter(r => r.event_id); const who = $('Check Cancel or Edit Command').first().json; if (rows.length === 0) return { ok: false, reasons: ['TOKEN_NOT_FOUND_OR_ALREADY_USED'] }; if (rows.length > 1) return { ok: false, reasons: ['DUPLICATE_TOKEN_HASH'] }; const r = rows[0]; const reasons = []; if (r.status !== 'APPROVAL_ISSUED') reasons.push('NOT_INVALIDATABLE:' + r.status); if (String(r.sender_id) !== String(who.sender_id)) reasons.push('SENDER_MISMATCH'); return { ok: reasons.length === 0, reasons: reasons, event_id: r.event_id, new_status: who.verb === 'EDIT' ? 'SUPERSEDED_BY_EDIT' : 'CANCELLED' }; })() }}"
            }
