              "id": "c6",
              "name": "message",
              "type": "string",
              "value": "={{ (() => { const h = $('Hash Binding').first().json; const v = $('Validate Fields').first().json; const r = $('Resolve References').first().json.resolution; const lines = [ '📝 <b>TRANSACTION PREVIEW (NOT COMMITTED)</b>', '───────────────────────────', '<b>Type:</b> ' + h.event_type ]; if (r.customer_name) { lines.push('<b>Customer:</b> ' + r.customer_name + ' (<code>' + r.customer_id + '</code>)'); } if (r.product_name) { lines.push('<b>Product:</b> ' + r.product_name + ' (<code>' + r.product_id + '</code>)'); } if (v.amount) { lines.push('<b>Amount:</b> Rs ' + v.amount); } if (v.quantity) { lines.push('<b>Quantity:</b> ' + v.quantity + ' ' + (v.unit || r.product_unit)); } if (h.event_type === 'CREDIT_SALE') { lines.push('<b>Current Debt:</b> Rs ' + r.current_debt + ' ➔ <b>Projected:</b> Rs ' + r.projected_debt + ' (Limit: Rs ' + r.credit_limit + ')'); } else if (h.event_type === 'REPAYMENT') { lines.push('<b>Current Debt:</b> Rs ' + r.current_debt + ' ➔ <b>Projected:</b> Rs ' + r.projected_debt); } else if (['STOCK_IN', 'STOCK_OUT', 'ACCEPTED_ORDER'].includes(h.event_type)) { lines.push('<b>Current Stock:</b> ' + r.current_stock + ' ' + r.product_unit + ' ➔ <b>Projected:</b> ' + r.projected_stock + ' ' + r.product_unit); } lines.push('<b>Ledger Revision:</b> ' + h.ledger_revision); lines.push('<b>Event ID:</b> <code>' + h.event_id + '</code>'); lines.push('───────────────────────────'); lines.push('👉 <b>To approve and commit to ledger, reply:</b>'); lines.push('<code>COMMIT ' + h.approval_code + '</code>'); lines.push(''); lines.push('⏳ <i>Valid for 90 seconds. To cancel, reply:</i>'); lines.push('<code>CANCEL ' + h.approval_code + '</code>'); return lines.join('\\n'); })() }}"
