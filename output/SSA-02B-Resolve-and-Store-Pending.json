    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "rr1",
              "name": "resolution",
              "type": "object",
              "value": "={{ (() => { const j = $('Validate Fields').first().json; const norm = s => String(s ?? '').trim().toLowerCase().split(' ').filter(x => x).join(' '); const rows = (n, idf) => $(n).all().map(i => i.json).filter(r => r[idf] && r.shop_id === j.shop_id); const customers = rows('Lookup Customers', 'customer_id'); const products = rows('Lookup Products', 'product_id'); const find = (list, idf, id, name) => { if (id) return list.filter(r => r[idf] === id); const q = norm(name); const exact = list.filter(r => norm(r.name) === q); return exact.length ? exact : list.filter(r => norm(r.name).includes(q)); }; const errors = []; const clarify = []; const out = {}; const needC = ['CREDIT_SALE','REPAYMENT','ACCEPTED_ORDER'].includes(j.event_type); const needP = ['STOCK_IN','STOCK_OUT','ACCEPTED_ORDER'].includes(j.event_type); if (needC) { const m = find(customers, 'customer_id', j.customer_id, j.customer_name); if (m.length === 1) { out.customer_id = m[0].customer_id; out.customer_name = m[0].name; out.current_debt = Number(m[0].current_debt ?? 0); out.credit_limit = Number(m[0].credit_limit ?? 5000); if (j.event_type === 'CREDIT_SALE') { if ((out.current_debt + j.amount) > out.credit_limit) { errors.push('Credit limit exceeded for ' + m[0].name + '. Current debt: Rs ' + out.current_debt + ', Limit: Rs ' + out.credit_limit + ', Requested: Rs ' + j.amount); } out.projected_debt = out.current_debt + j.amount; } else if (j.event_type === 'REPAYMENT') { out.projected_debt = Math.max(0, out.current_debt - j.amount); } } else if (m.length === 0) { errors.push('Unknown customer: ' + (j.customer_id || j.customer_name)); } else { clarify.push('Which customer did you mean? ' + m.map(r => r.customer_id + ' ' + r.name).join(' | ')); } } if (needP) { const m = find(products, 'product_id', j.product_id, j.product_name); if (m.length === 1) { out.product_id = m[0].product_id; out.product_name = m[0].name; out.product_unit = m[0].unit; out.current_stock = Number(m[0].current_stock ?? 0); out.unit_price = Number(m[0].unit_price ?? 0); if (j.unit && j.unit !== m[0].unit) { errors.push('Unit mismatch for ' + m[0].name + ': expected ' + m[0].unit + ', got ' + j.unit); } if (['STOCK_OUT', 'ACCEPTED_ORDER'].includes(j.event_type)) { if (j.quantity > out.current_stock) { errors.push('Insufficient stock for ' + m[0].name + '. Available: ' + out.current_stock + ' ' + m[0].unit + ', Requested: ' + j.quantity + ' ' + j.unit); } out.projected_stock = out.current_stock - j.quantity; } else if (j.event_type === 'STOCK_IN') { out.projected_stock = out.current_stock + j.quantity; } } else if (m.length === 0) { errors.push('Unknown product: ' + (j.product_id || j.product_name)); } else { clarify.push('Which product did you mean? ' + m.map(r => r.product_id + ' ' + r.name).join(' | ')); } } const ls = $('Lookup Ledger State').all().map(i => i.json).filter(r => r.shop_id === j.shop_id && r.journal_id); if (ls.length !== 1) { errors.push('Ledger state missing or not unique for shop ' + j.shop_id); } else { out.journal_id = ls[0].journal_id; out.ledger_revision = Number(ls[0].revision ?? 1); } return Object.assign({ outcome: errors.length ? 'REJECTED' : (clarify.length ? 'CLARIFICATION_NEEDED' : 'OK'), errors: errors, clarify: clarify }, out); })() }}"
            }
          ]
        },
        "options": {}
