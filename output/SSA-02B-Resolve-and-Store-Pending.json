              "name": "check",
              "type": "object",
              "value": "={{ (() => { const rows = $input.all().map(i => i.json).filter(r => r.event_id); if (rows.length === 0) return { state: 'NOT_FOUND', usable: false }; if (rows.length > 1) return { state: 'DUPLICATE_EVENT_ID', usable: false }; const r = rows[0]; const now = $now.toMillis(); if (r.status !== 'APPROVAL_ISSUED' && r.status !== 'PENDING') return { state: 'NOT_PENDING', status: r.status, usable: false }; if (now > r.expires_epoch) return { state: 'EXPIRED', seconds_overdue: Math.round((now - r.expires_epoch) / 1000), usable: false }; return { state: 'VALID_APPROVAL', seconds_left: Math.round((r.expires_epoch - now) / 1000), usable: true, token_hash_present: !!r.token_hash }; })() }}"
