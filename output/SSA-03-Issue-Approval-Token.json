    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "che0",
              "name": "verdict",
              "type": "object",
              "value": "={{ (() => { const rows = $('Get Proposal').all().map(i => i.json).filter(r => r.event_id); const led = $('Get Ledger State').all().map(i => i.json).filter(r => r.journal_id); const who = $('Issue Input').first().json; const ownerId = $env.OWNER_TELEGRAM_ID || '7973198714'; const reasons = []; if (rows.length === 0) return { ok: false, reasons: ['PROPOSAL_NOT_FOUND'] }; if (rows.length > 1) return { ok: false, reasons: ['DUPLICATE_EVENT_ID'] }; const r = rows[0]; if (String(who.sender_id) !== String(ownerId)) reasons.push('NOT_OWNER'); if (String(r.sender_id) !== String(who.sender_id)) reasons.push('SENDER_MISMATCH'); if (r.status !== 'PENDING') reasons.push('NOT_PENDING:' + r.status); if (r.token_hash) reasons.push('TOKEN_ALREADY_ISSUED'); if ($now.toMillis() > r.expires_epoch) reasons.push('EXPIRED'); if (led.length !== 1) reasons.push('LEDGER_STATE_UNAVAILABLE'); else if (led[0].revision !== r.ledger_revision || led[0].journal_id !== r.journal_id) reasons.push('STALE_LEDGER_REVISION'); return { ok: reasons.length === 0, reasons: reasons }; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f8c82bbb-bcc3-4210-9dcf-8816ac491351",
