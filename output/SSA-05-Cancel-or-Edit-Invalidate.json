              "id": "ep1",
              "name": "parsed",
              "type": "object",
              "value": "={{ (() => { const raw = String($('Validate Invalidation').first().json.verdict.edit_text || '').trim(); const w = raw.split(' ').filter(x => x); const cmd = (w[0] || '').toUpperCase().split('/').join(''); const rest = w.slice(1); const num = s => { const n = Number(String(s).replace(/[₹,]/g, '')); return String(s).trim() !== '' && isFinite(n) ? n : String(s); }; const tail = arr => ({ product_name: arr.slice(0, -2).join(' '), quantity: num(arr[arr.length - 2]), unit: String(arr[arr.length - 1]).toLowerCase() }); const orig = $('Validate Invalidation').first().json.verdict.original_proposal; const base = { shop_id: orig.shop_id, sender_id: orig.sender_id, chat_id: orig.chat_id, source_update_id: orig.source_update_id, source_message_id: orig.source_message_id, source_text: raw }; if (cmd === 'SALE' && rest.length === 1) return Object.assign(base, { event_type: 'SALE', amount: num(rest[0]) }); if ((cmd === 'CREDIT' || cmd === 'REPAY') && rest.length >= 2) return Object.assign(base, { event_type: cmd === 'CREDIT' ? 'CREDIT_SALE' : 'REPAYMENT', customer_name: rest.slice(0, -1).join(' '), amount: num(rest[rest.length - 1]) }); if ((cmd === 'STOCKIN' || cmd === 'STOCKOUT') && rest.length >= 3) return Object.assign(base, { event_type: cmd === 'STOCKIN' ? 'STOCK_IN' : 'STOCK_OUT' }, tail(rest)); if (cmd === 'ORDER') { const p = raw.slice(raw.indexOf(' ') + 1).split('|'); const pw = p.length === 2 ? p[1].trim().split(' ').filter(x => x) : []; if (p.length === 2 && p[0].trim() && pw.length >= 3) return Object.assign(base, { event_type: 'ACCEPTED_ORDER', customer_name: p[0].trim() }, tail(pw)); } return Object.assign(base, { event_type: 'INVALID_EDIT_SYNTAX' }); })() }}"
            }
