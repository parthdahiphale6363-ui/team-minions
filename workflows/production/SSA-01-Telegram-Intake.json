    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fs0",
              "name": "message",
              "type": "string",
              "value": "={{ (() => { const q = String($('Parse Command').first().json.parsed.query_arg || '').trim(); const rows = $input.all().map(i => i.json).filter(r => r.product_id); if (q) { const norm = s => String(s || '').toLowerCase().trim(); const match = rows.filter(r => norm(r.name).includes(norm(q)) || norm(r.product_id) === norm(q)); if (match.length === 1) { const p = match[0]; return [ '📦 <b>PRODUCT STOCK DETAILS</b>', '───────────────────────────', '<b>Product:</b> ' + p.name + ' (<code>' + p.product_id + '</code>)', '<b>Current Stock:</b> ' + (p.current_stock ?? 0) + ' ' + (p.unit || 'units'), '<b>Unit Price:</b> Rs ' + (p.unit_price || 'N/A') + ' per ' + (p.unit || 'unit') ].join('\\n'); } else if (match.length > 1) { return '❓ <b>Multiple products matched:</b>\\n' + match.map(r => '• <code>' + r.product_id + '</code> ' + r.name + ' (' + r.current_stock + ' ' + r.unit + ')').join('\\n'); } else { return '❌ <b>Product Not Found:</b> ' + q; } } return [ '📦 <b>SHOP INVENTORY STOCK SUMMARY</b>', '───────────────────────────', rows.map(r => '• ' + r.name + ' (<code>' + r.product_id + '</code>): <b>' + (r.current_stock ?? 0) + ' ' + (r.unit || '') + '</b> (Rs ' + (r.unit_price || 0) + '/' + (r.unit || 'unit') + ')').join('\\n') ].join('\\n'); })() }}"
            }
          ]
        },
        "options": {}
      },
