              "id": "pc1",
              "name": "parsed",
              "type": "object",
              "value": "={{ (() => { const raw = String($('Extract Update Fields').first().json.text || '').trim(); const w = raw.split(' ').filter(x => x); const cmd = (w[0] || '').toUpperCase().split('/').join(''); const rest = w.slice(1); const num = s => { const n = Number(String(s).replace(/[₹,]/g, '')); return String(s).trim() !== '' && isFinite(n) ? n : String(s); }; const tail = arr => ({ product_name: arr.slice(0, -2).join(' '), quantity: num(arr[arr.length - 2]), unit: String(arr[arr.length - 1]).toLowerCase() }); if (cmd === 'COMMIT' && rest.length === 1 && /^[0-9a-f]{16}$/i.test(rest[0])) return { kind: 'COMMIT', token: rest[0].toLowerCase() }; if (cmd === 'CANCEL' && rest.length === 1 && /^[0-9a-f]{16}$/i.test(rest[0])) return { kind: 'CANCEL', token: rest[0].toLowerCase() }; if (cmd === 'EDIT' && rest.length >= 2 && /^[0-9a-f]{16}$/i.test(rest[0])) return { kind: 'EDIT', token: rest[0].toLowerCase(), edit_text: rest.slice(1).join(' ') }; if (cmd === 'SALE' && rest.length === 1) return { kind: 'TRANSACTION', event_type: 'SALE', amount: num(rest[0]) }; if ((cmd === 'CREDIT' || cmd === 'REPAY') && rest.length >= 2) return { kind: 'TRANSACTION', event_type: cmd === 'CREDIT' ? 'CREDIT_SALE' : 'REPAYMENT', customer_name: rest.slice(0, -1).join(' '), amount: num(rest[rest.length - 1]) }; if ((cmd === 'STOCKIN' || cmd === 'STOCKOUT') && rest.length >= 3) return Object.assign({ kind: 'TRANSACTION', event_type: cmd === 'STOCKIN' ? 'STOCK_IN' : 'STOCK_OUT' }, tail(rest)); if (cmd === 'ORDER') { const p = raw.slice(raw.indexOf(' ') + 1).split('|'); const pw = p.length === 2 ? p[1].trim().split(' ').filter(x => x) : []; if (p.length === 2 && p[0].trim() && pw.length >= 3) return Object.assign({ kind: 'TRANSACTION', event_type: 'ACCEPTED_ORDER', customer_name: p[0].trim() }, tail(pw)); } if (['BALANCE', 'STOCK', 'HELP'].includes(cmd)) return { kind: 'QUERY', query_type: cmd, query_arg: rest.join(' ').trim() }; return { kind: 'UNSUPPORTED' }; })() }}"
            }
