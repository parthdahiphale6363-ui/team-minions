              "id": "fb0",
              "name": "message",
              "type": "string",
              "value": "={{ (() => { const q = String($('Parse Command').first().json.parsed.query_arg || '').trim(); const rows = $input.all().map(i => i.json).filter(r => r.customer_id); if (q) { const norm = s => String(s || '').toLowerCase().trim(); const match = rows.filter(r => norm(r.name).includes(norm(q)) || norm(r.customer_id) === norm(q)); if (match.length === 1) { const c = match[0]; const debt = Number(c.current_debt ?? 0); const limit = Number(c.credit_limit ?? 5000); return [ '👤 <b>CUSTOMER BALANCE & CREDIT</b>', '───────────────────────────', '<b>Customer:</b> ' + c.name + ' (<code>' + c.customer_id + '</code>)', '<b>Outstanding Debt:</b> Rs ' + debt, '<b>Credit Limit:</b> Rs ' + limit, '<b>Available Credit:</b> Rs ' + Math.max(0, limit - debt), '<b>Phone:</b> ' + (c.phone || 'N/A') ].join('\\n'); } else if (match.length > 1) { return '❓ <b>Multiple customers matched:</b>\\n' + match.map(r => '• <code>' + r.customer_id + '</code> ' + r.name + ' (Debt: Rs ' + (r.current_debt || 0) + ')').join('\\n'); } else { return '❌ <b>Customer Not Found:</b> ' + q; } } const debtors = rows.filter(r => Number(r.current_debt ?? 0) > 0); const totalDebt = debtors.reduce((sum, r) => sum + Number(r.current_debt ?? 0), 0); return [ '📊 <b>SHOP CREDIT BALANCE SUMMARY</b>', '───────────────────────────', '<b>Total Outstanding Debt:</b> Rs ' + totalDebt, '<b>Debtors Count:</b> ' + debtors.length, '───────────────────────────', debtors.length ? debtors.map(r => '• ' + r.name + ' (<code>' + r.customer_id + '</code>): <b>Rs ' + r.current_debt + '</b>').join('\\n') : '🎉 <i>No outstanding customer debt!</i>' ].join('\\n'); })() }}"
